{
  "name": "twolittle-bites-os-supabase-dev",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run verify:blueprint && npm run test && npm run build && npm run audit:scaffold",
    "verify:blueprint": "node specs/tools/verify_blueprint.mjs",
    "audit:scaffold": "node scripts/audit-scaffold.mjs",
    "sync": "git push -u origin HEAD",
    "rollback": "git checkout -- . && git clean -fd"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
